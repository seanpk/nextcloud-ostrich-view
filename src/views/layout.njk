<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <title>{{ title }} · Ostrich View</title>
    <link rel="stylesheet" href="/public/styles.css?v={{ appVersion }}" />
    <link rel="icon" href="/public/icons/folder.svg" type="image/svg+xml" />
    {# Pages that need something of their own in <head>; only the upstream-down
       page uses it, for its self-retry meta refresh. #}
    {% block head %}{% endblock %}
  </head>
  <body class="{{ 'is-viewer' if immersive }}">
    {#
      The top bar is fixed so the Back button is reachable from anywhere on the
      page without scrolling. It is hidden only on home and login, where there
      is nowhere to go back to.
    #}
    <header class="topbar">
      <div class="topbar__inner">
        {% if showBack %}
          <a class="back" href="{{ backHref | default('/') }}" rel="nofollow">
            <span class="back__chevron" aria-hidden="true">&lsaquo;</span>
            <span class="back__label">Back</span>
          </a>
        {% else %}
          <span class="back-placeholder" aria-hidden="true"></span>
        {% endif %}

        <span class="topbar__brand">Ostrich View</span>

        {#
          Every page inside the app sets showToggle=true and
          section='files'|'tasks': switching sections must never require backing
          out to the home screen first. Login is the one page without it.
        #}
        {% if showToggle %}
          <nav class="toggle" aria-label="Sections">
            <a class="toggle__option {{ 'is-current' if section == 'files' }}" href="/">Files</a>
            <a class="toggle__option {{ 'is-current' if section == 'tasks' }}" href="/tasks">Tasks</a>
          </nav>
        {% endif %}
      </div>
    </header>

    <main class="page" id="main">
      {% if breadcrumbs and breadcrumbs.length > 1 %}
        {# Unobtrusive "where am I" line -- muted, small, never the main event. #}
        <nav class="crumbs" aria-label="Current location">
          {% for crumb in breadcrumbs %}
            {% if loop.last %}
              <span class="crumbs__here" aria-current="page">{{ crumb.name }}</span>
            {% else %}
              <a class="crumbs__link" href="{{ crumb.href }}">{{ crumb.name }}</a>
              <span class="crumbs__sep" aria-hidden="true">/</span>
            {% endif %}
          {% endfor %}
        </nav>
      {% endif %}

      {#
        Immersive (full-screen photo/PDF) pages keep the heading in the DOM --
        it is still the document's title, and public/viewer.js's status line
        refers back to it -- but hidden visually, since the filename already
        rides along on the image's alt text / the PDF iframe's title.
      #}
      <h1 class="page__title {{ 'visually-hidden' if immersive }}">{% block heading %}{{ title }}{% endblock %}</h1>

      {% block content %}{% endblock %}
    </main>

    {% if not immersive %}
      <footer class="footer">
        {% if viewer %}
          <form class="footer__form" method="post" action="/logout">
            <button class="footer__logout" type="submit">Sign out</button>
          </form>
        {% endif %}
      </footer>
    {% endif %}

    {# Pages that ship a bit of progressive-enhancement JS add their <script> here. #}
    {% block scripts %}{% endblock %}
  </body>
</html>
