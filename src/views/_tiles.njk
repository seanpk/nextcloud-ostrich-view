{#
  Shared tile grid. One macro so the Files home and every folder listing stay
  visually identical -- same thumbnail, same target size, same "there is
  nothing to tap here" fallback. When `tile.previewUrl` is set the thumbnail
  replaces the icon.

  The stream draws rows rather than tiles and has its own macro (_stream.njk):
  a page you read down wants a different shape from a page you look through.
  Both are fed by the same `toTile`, so they cannot disagree about what a file
  is or where it opens.
#}

{% macro tile_body(tile) %}
  <span class="tile__thumb">
    {% if tile.previewUrl %}
      <img class="tile__preview" src="{{ tile.previewUrl }}" alt="Preview of {{ tile.name }}" loading="lazy" />
    {% else %}
      <img class="tile__icon" src="{{ tile.icon }}" alt="" aria-hidden="true" />
    {% endif %}
  </span>
  <span class="tile__text">
    <span class="tile__name">{{ tile.name }}</span>
    {% if tile.sizeLabel %}
      <span class="tile__meta">{{ tile.sizeLabel }}</span>
    {% endif %}
  </span>
{% endmacro %}

{% macro tile_grid(tiles, empty_message) %}
  {% if tiles and tiles.length %}
    <ul class="tiles">
      {% for tile in tiles %}
        <li class="tiles__item">
          {% if tile.href %}
            <a class="tile tile--{{ tile.kind }}" href="{{ tile.href }}">
              {{ tile_body(tile) }}
            </a>
          {% else %}
            <div class="tile tile--{{ tile.kind }} tile--static">
              {{ tile_body(tile) }}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="empty">{{ empty_message }}</p>
  {% endif %}
{% endmacro %}
