{
  "name": "nextcloud-ostrich-view",
  "version": "0.2.0",
  "private": true,
  "description": "Read-only, big-button viewer for files and tasks shared to a dedicated Nextcloud account.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node --watch --env-file=.env src/index.js",
    "demo": "node scripts/demo.js",
    "screenshots": "node scripts/screenshots.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "hash": "node scripts/hash-passphrase.js",
    "pdfjs": "node scripts/copy-pdfjs.js",
    "prepare": "node scripts/copy-pdfjs.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/secure-session": "^8.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^10.0.1",
    "bcryptjs": "^2.4.3",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.2.1",
    "ical.js": "^2.2.1",
    "mammoth": "^1.12.2",
    "nunjucks": "^3.2.4",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
